        "spec": {
          "id": 1,
          "title": "Uso de CPU por nodo",
          "description": "Porcentaje de CPU no ociosa, promediado entre los núcleos de cada instancia.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
